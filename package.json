{
  "name": "authena",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A Kleros Curate list of agent skills that are safe to install, judged by GenLayer validators.",
  "scripts": {
    "compile": "node scripts/compile.mjs",
    "test:evm": "node scripts/compile.mjs && node --test evm/test/arbitrator.test.mjs",
    "test:contract": "python -m pytest tests/direct -q",
    "test": "npm run test:evm && npm run test:contract"
  },
  "devDependencies": {
    "ganache": "^7.9.2",
    "solc": "0.8.26",
    "tsx": "^4.19.0",
    "viem": "^2.21.0"
  },
  "dependencies": {
    "genlayer-js": "^1.1.8"
  }
}
